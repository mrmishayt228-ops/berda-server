<Window x:Class="BerdaKeyGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BerdaKeyGen"
        Title="Berda KeyGen"
        Width="500" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Border CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource BrBorder}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#1E0E3C"/>
                <GradientStop Offset="0.55" Color="#2B125A"/>
                <GradientStop Offset="1.0" Color="#4A1E86"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <local:ParticlesControl/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- title bar -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="BERDA" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="  KEYGEN" FontSize="12" Foreground="{StaticResource BrAccent2}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,8,0">
                        <Button Style="{StaticResource IconBarBtn}" Click="MinimizeBtn_Click" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"/>
                        <Button Style="{StaticResource IconBarBtn}" Click="CloseBtn_Click" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">

                    <!-- ============ LOGIN ============ -->
                    <Grid x:Name="LoginPanel">
                        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ГЕНЕРАТОР КЛЮЧЕЙ" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrText}" HorizontalAlignment="Center"/>
                            <TextBlock Text="доступно только владельцу" FontSize="12" Foreground="{StaticResource BrAccent2}"
                                       HorizontalAlignment="Center" Margin="0,4,0,24"/>
                            <local:HintBox x:Name="LoginField" Hint="Логин владельца" Height="42" Style="{StaticResource HintInput}"/>
                            <Grid Height="42" Margin="0,10,0,0">
                                <Border Background="{StaticResource BrInputBg}" BorderBrush="{StaticResource BrInputBorder}"
                                        BorderThickness="1" CornerRadius="9"/>
                                <TextBlock x:Name="PassFieldHint" Text="Пароль" Foreground="{StaticResource BrTextFaint}"
                                           FontSize="14" Margin="13,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <PasswordBox x:Name="PassField" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource BrText}" CaretBrush="{StaticResource BrAccent}"
                                             FontSize="14" VerticalContentAlignment="Center" Margin="10,0,10,0"
                                             KeyDown="PassField_KeyDown"/>
                            </Grid>
                            <TextBlock x:Name="LoginStatus" Foreground="#FFFF6E6E" FontSize="12" Margin="2,8,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                            <Button x:Name="LoginBtn" Style="{StaticResource AccentBtn}" Content="ВОЙТИ"
                                    Height="46" Margin="0,14,0,0" Click="LoginBtn_Click"/>
                            <Button x:Name="ServerToggle" Style="{StaticResource GhostBtn}" Content="Сервер..."
                                    Margin="0,8,0,0" Click="ServerToggle_Click"/>
                            <Grid x:Name="ServerGrid" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <local:HintBox x:Name="ServerField" Hint="http://127.0.0.1:8080" Height="36"
                                               Style="{StaticResource HintInput}"/>
                                <Button Grid.Column="1" Content="OK" Style="{StaticResource AccentBtn}" Width="52"
                                        Height="36" Margin="8,0,0,0" Click="ServerSave_Click"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="v1.0 • owner tool" FontSize="11" Foreground="{StaticResource BrTextFaint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                    </Grid>

                    <!-- ============ MAIN ============ -->
                    <Grid x:Name="MainPanel" Visibility="Collapsed" Margin="24,10,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Создание ключей" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrText}" VerticalAlignment="Center"/>
                            <Button x:Name="LogoutBtn" Style="{StaticResource GhostBtn}" Content="Выйти"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="LogoutBtn_Click"/>
                        </Grid>

                        <!-- create card -->
                        <Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="16,14" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Дней" FontSize="12" Foreground="{StaticResource BrTextDim}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <local:HintBox x:Name="DaysField" Grid.Column="1" Height="34" Text="30"
                                                   Style="{StaticResource HintInput}" Hint="30"/>
                                    <TextBlock Grid.Column="2" Text="Часов" FontSize="12" Foreground="{StaticResource BrTextDim}"
                                               VerticalAlignment="Center" Margin="14,0,8,0"/>
                                    <local:HintBox x:Name="HoursField" Grid.Column="3" Height="34" Text="0"
                                                   Style="{StaticResource HintInput}" Hint="0"/>
                                </Grid>
                                <local:HintBox x:Name="NoteField" Height="34" Style="{StaticResource HintInput}"
                                               Hint="Комментарий (необязательно)"/>
                                <Grid Margin="0,12,0,0">
                                    <Button x:Name="CreateBtn" Style="{StaticResource AccentBtn}" Content="СОЗДАТЬ КЛЮЧ"
                                            Height="38" Width="180" Click="CreateBtn_Click"/>
                                    <TextBlock x:Name="CreateStatus" FontSize="12" Foreground="#FFFF6E6E"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                               TextWrapping="Wrap" Visibility="Collapsed"/>
                                </Grid>
                                <Grid Margin="0,12,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ResLabel" Text="Новый ключ: " FontSize="13"
                                               Foreground="{StaticResource BrTextDim}" VerticalAlignment="Center"/>
                                    <local:HintBox x:Name="ResultKey" Grid.Column="1" Style="{StaticResource HintInput}"
                                                   Height="36" IsReadOnly="True" Foreground="{StaticResource BrAccent2}"
                                                   FontWeight="SemiBold"/>
                                    <Button x:Name="CopyBtn" Grid.Column="1" Style="{StaticResource AccentBtn}" Content="КОПИРОВАТЬ"
                                            Height="36" Width="120" HorizontalAlignment="Right" Click="CopyBtn_Click"
                                            Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- keys list -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="СОЗДАННЫЕ КЛЮЧИ" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BrTextFaint}" Margin="2,0,0,4"/>
                            <ListView x:Name="KeysList" Grid.Row="1" Background="#22000000"
                                      Foreground="{StaticResource BrTextDim}" BorderBrush="{StaticResource BrInputBorder}"
                                      BorderThickness="1" FontSize="12"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Ключ" Width="185" DisplayMemberBinding="{Binding Code}"/>
                                        <GridViewColumn Header="Срок" Width="85" DisplayMemberBinding="{Binding DurationText}"/>
                                        <GridViewColumn Header="Статус" Width="70" DisplayMemberBinding="{Binding StatusText}"/>
                                        <GridViewColumn Header="Исп." Width="100" DisplayMemberBinding="{Binding UsedByText}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Foreground" Value="{StaticResource BrTextDim}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <Button x:Name="DelKeyBtn" Grid.Row="2" Style="{StaticResource AccentBtn}" Content="УДАЛИТЬ ВЫБРАННЫЙ КЛЮЧ"
                                    Height="34" Margin="0,10,0,0" IsEnabled="False" Click="DelKeyBtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>